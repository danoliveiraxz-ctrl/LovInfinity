{
  "manifest_version": 3,
  "name": "LovInfinity",
  "version": "1.0.0",
  "description": "LovInfinity — acesso licenciado e ferramentas inteligentes.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://expxqynyrafienedsmuw.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LovInfinity",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}